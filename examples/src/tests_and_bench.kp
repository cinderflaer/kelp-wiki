// tests_and_bench: a self-test report and a timing line, in one program.
//
//   kelpc run main.kp
//
// Dependencies:
//
//   [dependencies]
//   testkit  = "Juniper/fpl/testkit"
//   benchkit = "Juniper/fpl/benchkit"
//
// `benchkit` calls the monotonic clock, so it needs `time` delegated, the same
// rule that applies to any gated dependency.
//
// Demonstrates: the typed check helpers (there is no overloaded `check_eq`, so
// there is one per type), a summary line, and `time_many`'s warmup-then-measure
// shape over a closure.

impl "deps/testkit/lib" as testkit
impl "deps/benchkit/lib" as benchkit caps(time = [])
impl "std/str"

fun sum_to(n: i64).R: i64 {
    var acc: i64 = 0
    var i: i64 = 1
    while i <= n {
        acc += i
        i += 1
    }
    return acc
}

fun work() {
    val ignored = sum_to(1000)
    if ignored < 0 {
        print("unreachable")
    }
}

fun main() {
    var report = testkit.new_report()
    testkit.check_eq_i64(report, sum_to(10), 55, "sum_to(10)")
    testkit.check_eq_i64(report, sum_to(0), 0, "sum_to(0)")
    testkit.check_eq_str(report, "kelp", "kelp", "two literals compare equal")
    testkit.check_eq_bool(report, sum_to(3) == 6, true, "sum_to(3)")
    testkit.check(report, sum_to(100) > 0, "a large sum is positive")
    print(testkit.summary(&report))

    if !testkit.all_passed(&report) {
        print(testkit.failure_list(&report))
    }

    val samples = benchkit.time_many(fun() = work(), 2, 5)
    print(benchkit.report_line("sum_to(1000)", samples))
}
