// ping-pong-client: talk to `ping-pong-server` with PING, then QUIT.
//
//   kelpc build ping-pong-client.kp -o ping-pong-client && ./ping-pong-client 4599
//
// Demonstrates: connecting to a granted host, sending CRLF-terminated lines, and
// reading one reply at a time from a buffered reader (a client that reads a line
// only after writing one never has to reason about overshoot).

impl "std/net"
impl "std/str"
impl "std/process"
impl "deps/lineproto/lib" caps(net = ["127.0.0.1:*"])

fun port_from(argv: List<String>) => u16 {
    if argv.len() >= 2 {
        val parsed = str.parseI64(argv.get(1).as_str())
        if let Ok(v) = parsed {
            return v.to_u16()
        }
    }
    return 4599
}

fun main() {
    val argv = process.args()
    val port = port_from(argv)

    val sock = net.connect("127.0.0.1", port)
    var reader = lineproto.new_reader(sock)

    lineproto.send_line(sock, "PING")
    val first = reader.readLine()
    if let Some(text) = first {
        print(text)
    }

    lineproto.send_line(sock, "QUIT")
    val second = reader.readLine()
    if let Some(text) = second {
        print(text)
    }

    net.close(sock)
}
