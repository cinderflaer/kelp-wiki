// recursive-fibonacci: the first twenty Fibonacci numbers, recursively.
//
//   kelpc run recursive-fibonacci.kp
//
// Demonstrates: recursion, a `for` loop over `iter.range`, `print!` against `print`, and integer
// width conversion (the loop counter is an `i64` because `recursive-fibonacci` takes one).

impl "std/iter"

fun fib(n: i64) => i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fun main() {
    for i in iter.range(0, 20) {
        print!(fib(i))
        if i < 19 {
            print!(" ")
        }
    }
    print("")
}
