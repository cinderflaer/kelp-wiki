// recursive-fibonacci: the first twenty Fibonacci numbers, recursively.
//
//   kelpc run recursive-fibonacci.kp
//
// Demonstrates: recursion, a `while` loop, `print!` against `print`, and integer
// width conversion (the loop counter is an `i64` because `recursive-fibonacci` takes one).

fun fib(n: i64) => i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fun main() {
    var i: i64 = 0
    while i < 20 {
        print!(fib(i))
        if i < 19 {
            print!(" ")
        }
        i += 1
    }
    print("")
}
